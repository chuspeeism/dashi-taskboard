    { "id": "delivery_review", "lane": "taskboard", "col": 5, "type": "database", "label": "交付验收", "sublabel": "等待用户确认" },
    { "id": "accept_done", "lane": "user", "col": 5, "type": "security", "label": "接受交付", "sublabel": "任务完成" }
