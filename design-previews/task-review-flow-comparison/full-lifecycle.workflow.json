  "cards": [
    { "dot": "violet", "title": "阶段必须分清", "items": ["需求审核发生在开发前", "交付验收发生在开发后", "Sol 讨论本身不改变任务状态"] },
    { "dot": "emerald", "title": "当前负责人可见", "items": ["等待用户时显示你需要做什么", "AI 执行时显示关联对话与轮次", "每个节点都有明确的下一步"] }
  ]
