    "viewBox": [1440, 820],
    "views": [
      { "id": "readiness", "label": "需求审核", "focus": ["move_todo", "sol_review", "wait_user", "user_reply", "sol_recheck"], "note": "评论只在等待确认时继续同一轮审核。" },
      { "id": "delivery", "label": "开发与验收", "focus": ["sol_recheck", "agent_build", "delivery_review", "accept_done"], "note": "开发完成后的审核应明确叫交付验收。" }
    ]
  },
  "lanes": [
    { "id": "user", "label": "用户" },
    { "id": "taskboard", "label": "Taskboard" },
    { "id": "sol", "label": "Sol 5.6" },
    { "id": "agent", "label": "开发 Agent" }
  ],
  "phases": [
    { "id": "phase_review", "label": "开发前需求审核", "fromCol": 0, "toCol": 4, "variant": "emphasis" },
    { "id": "phase_delivery", "label": "开发与交付", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["move_todo", "sol_review", "wait_user", "user_reply", "sol_recheck", "agent_build", "delivery_review", "accept_done"],
  "nodes": [
    { "id": "move_todo", "lane": "user", "col": 0, "type": "external", "label": "移到待开发", "sublabel": "用户明确启动" },
    { "id": "sol_review", "lane": "sol", "col": 1, "type": "backend", "label": "需求审核", "sublabel": "Sol X-High · 只读" },
    { "id": "wait_user", "lane": "taskboard", "col": 2, "type": "messagebus", "label": "等待你补充", "sublabel": "待解决 / 待我评论" },
    { "id": "user_reply", "lane": "user", "col": 3, "type": "frontend", "label": "补充评论", "sublabel": "继续当前审核" },
    { "id": "sol_recheck", "lane": "sol", "col": 4, "type": "backend", "label": "Sol 复审", "sublabel": "形成通过结论" },
