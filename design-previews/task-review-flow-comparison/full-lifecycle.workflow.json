    { "from": "wait_user", "to": "user_reply", "role": "main" },
    { "from": "user_reply", "to": "sol_recheck", "role": "main", "variant": "emphasis" },
    { "from": "sol_recheck", "to": "agent_build", "role": "main", "variant": "emphasis" },
    { "from": "agent_build", "to": "delivery_review", "role": "main" },
    { "from": "delivery_review", "to": "accept_done", "role": "main", "variant": "emphasis" }
